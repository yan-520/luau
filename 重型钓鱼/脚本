local function checkFishingGui()
    local mainGui = lp.PlayerGui:FindFirstChild("MainGui")
    return mainGui and mainGui:FindFirstChild("Fishing") and mainGui.Fishing.Visible
end

local function isFishing()
    local char = lp.Character
    return char and char:GetAttribute("Fishing")
end

local function toggleHotbar()
    RS:WaitForChild("Events"):WaitForChild("ToggleHotbar"):InvokeServer("1")
end

local function cancelAndReEquip()
    toggleHotbar()
    toggleHotbar()
    local hasTool = false
    if workspace:FindFirstChild(lp.Name) and workspace[lp.Name]:FindFirstChild("Tool") then
        hasTool = true
    end
    if not hasTool then
        toggleHotbar()
    end
end

local function processAutoFarmSkill(keyName)
    pcall(function()
        if lp.Character and not isFishing() then
            RS.Events.Fishing:FireServer()
            task.wait(1)
        end
        if isFishing() and checkFishingGui() then
            RS.Events.UseSkill:FireServer(keyName)
            task.wait(0.1)
            local skillValueGt0 = false
            if workspace:FindFirstChild(lp.Name) and workspace[lp.Name]:FindFirstChild("Skills") then
                for _, skill in pairs(workspace[lp.Name].Skills:GetChildren()) do
                    if skill:GetAttribute("Key") == keyName and skill.Value > 0 then
                        skillValueGt0 = true
                        break
                    end
                end
            end
            if skillValueGt0 then
                cancelAndReEquip()
            end
        end
    end)
end

