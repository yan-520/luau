local function applyAnchor()
    pcall(function()
        if not getgenv().AnchorEnabled or not getgenv().AnchorPos then return end
        local char = lp.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local data = getgenv().AnchorPos
            local rx = data.rx or 0
            local ry = data.ry or 0
            local rz = data.rz or 0
            char.HumanoidRootPart.CFrame = CFrame.new(data.x, data.y, data.z) * CFrame.Angles(rx, ry, rz)
            char.HumanoidRootPart.Anchored = true
        end
    end)
end

local function releaseAnchor()
    pcall(function()
        local char = lp.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.Anchored = false
        end
    end)
end

