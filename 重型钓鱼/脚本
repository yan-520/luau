local skillOrder = {}
local currentSkillIndex = 1
local orderDisplayParagraph = nil

local function updateOrderDisplay()
    if not orderDisplayParagraph then return end
    local str = table.concat(skillOrder, " → ")
    if str == "" then str = "无" end
    orderDisplayParagraph:SetDesc(str)
end

local function addSkillToOrder(key)
    for i, k in ipairs(skillOrder) do
        if k == key then return end
    end
    table.insert(skillOrder, key)
    updateOrderDisplay()
end

local function removeSkillFromOrder(key)
    for i = #skillOrder, 1, -1 do
        if skillOrder[i] == key then
            table.remove(skillOrder, i)
            break
        end
    end
    if #skillOrder == 0 then
        currentSkillIndex = 1
    else
        currentSkillIndex = math.clamp(currentSkillIndex, 1, #skillOrder)
    end
    updateOrderDisplay()
end

